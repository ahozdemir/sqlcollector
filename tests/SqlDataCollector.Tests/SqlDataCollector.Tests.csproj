<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers" Version="4.17.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Integration\seed.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the installer is a WinForms exe (net10.0-windows): its options class has no UI dependencies and is tested by linking it -->
    <Compile Include="..\..\installer\SqlDataCollector.Setup\SetupOptions.cs" Link="Installer\SetupOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlDataCollector\SqlDataCollector.csproj" />
    <ProjectReference Include="..\..\src\SqlDataCollector.Core\SqlDataCollector.Core.csproj" />
  </ItemGroup>

</Project>