<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SqlHarbor-Setup.exe: installation wizard (and silent installer) for Windows servers.
    Published as one self-contained file that embeds the self-contained application (payload.zip):
    nothing has to be installed on the target server. Build: scripts\dev.ps1 installer
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SqlDataCollector.Setup</RootNamespace>
    <AssemblyName>SqlHarbor-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Product>SqlHarbor</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- the application (self-contained publish, zipped) is embedded by scripts\dev.ps1 installer -->
  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
