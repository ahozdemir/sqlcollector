{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet list:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1:*)",
      "Bash(pwsh -NoProfile -File scripts/dev.ps1:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker exec:*)",
      "Bash(docker images:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(docker compose -f docker/compose.yml --profile full --profile shared down -v:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./secrets/**)",
      "Read(**/*.pfx)",
      "Read(**/gcs-sa*.json)"
    ]
  }
}
