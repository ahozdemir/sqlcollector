{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sdc-local",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/dev.ps1", "run", "-SqlInstance", "."],
      "port": 5080
    },
    {
      "name": "sdc-local-firstrun",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$env:LocalAdmin__PasswordHash = ' '; & ./scripts/dev.ps1 run -SqlInstance ."],
      "port": 5080
    }
  ]
}
