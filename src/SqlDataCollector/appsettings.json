{
  "Urls": "http://0.0.0.0:5080",
  "ConnectionStrings": {
    "Metadata": "Server=DWH-SQL01;Database=DataCollectorMeta;Integrated Security=true;Encrypt=true;Application Name=SqlDataCollector",
    "Hangfire": ""
  },
  "Collector": {
    "Roles": "Web,Worker",
    "Queues": "sdc_export,sdc_extract,sdc_system",
    "HangfireSchema": "hangfire_collector",
    "HangfirePrepareSchema": true,
    "AutoCreateSchema": true,
    "SyncCron": "*/5 * * * *",
    "RetentionCron": "30 1 * * *",
    "SystemTimeZone": "Europe/Istanbul",
    "RunLogRetentionDays": 90,
    "DeleteBatchSize": 50000,
    "TargetTableCompression": "PAGE",
    "WorkDirectory": "D:\\SqlDataCollector\\work",
    "KeepLocalFiles": false,
    "LocalFileRetentionDays": 7,
    "WorkerCount": 4,
    "ExportReadAsUser": "sdc_export_reader"
  },
  "LocalAdmin": {
    "Enabled": true,
    "Username": "admin",
    "PasswordHash": ""
  },
  "Gcs": {
    "CredentialsPath": "D:\\SqlDataCollector\\secrets\\gcs-sa.json",
    "Endpoint": "",
    "UploadChunkSizeMb": 16,
    "MaxRetries": 4
  },
  "Alerts": {
    "PublicUrl": "",
    "Smtp": {
      "Host": "",
      "Port": 25,
      "Security": "Auto",
      "From": "sqldatacollector@corp.local"
    }
  },
  "Dashboard": {
    "Path": "/hangfire"
  },
  "SqlCredentialOverrides": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
