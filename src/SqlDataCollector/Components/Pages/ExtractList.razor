@page "/extract"
@attribute [Authorize(Policy = AppRoles.Viewer)]
@inject MetadataRepository Repo
@inject AccessService Access

<PageTitle>Extract Jobs</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="h4 mb-0 me-auto">Extract Jobs <HelpLink Topic="extract" Title="Extract jobs" /></h1>
    <input class="form-control form-control-sm w-auto me-2" placeholder="Search…" @bind="filter" @bind:event="oninput" />
    @if (canEdit) { <a class="btn btn-sm btn-primary" href="/extract/new">+ New job</a> }
</div>

<div class="sdc-table-scroll"><table class="table table-sm table-hover bg-white">
    <thead class="table-light">
        <tr><th>Name</th><th>Source</th><th>Target</th><th>Load mode</th><th>Schema</th><th>Schedule</th><th>Retention</th><th>Modified by</th></tr>
    </thead>
    <tbody>
        @foreach (var j in Filtered)
        {
            <tr class="@(j.IsActive ? "" : "text-muted")">
                <td class="sdc-nowrap"><a href="/extract/@j.ExtractJobId">@j.Name</a> @if (!j.IsActive) { <span class="badge bg-light text-dark border">inactive</span> }</td>
                <td class="mono sdc-nowrap">@(j.SourceType == SourceType.Table ? $"{j.SourceSchema}.{j.SourceTable}" : "(query)")<span class="sdc-sub">@j.SourceServerName / @j.SourceDatabase</span></td>
                <td class="mono sdc-nowrap">@j.TargetSchema.@j.TargetTable<span class="sdc-sub">@j.TargetServerName / @j.TargetDatabase</span></td>
                <td class="sdc-nowrap">@j.LoadMode @if (j.LoadMode == LoadMode.Incremental) { <span class="sdc-sub">watermark: @j.WatermarkColumn</span> } else if (j.LoadMode == LoadMode.Merge) { <span class="sdc-sub">key: @j.KeyColumns@(j.UseChangeTracking ? ", change tracking" : j.WatermarkColumn is null ? "" : ", wm: " + j.WatermarkColumn)</span> }
                    @if (j.UsesParallelRead() || j.UsesParallelWrite()) { <span class="sdc-sub">@ParallelLabel(j)</span> }</td>
                <td class="sdc-nowrap">@j.SchemaPolicy @if (j.PartitionDaily) { <span class="sdc-sub">daily partitions</span> }</td>
                <td><ScheduleCell Kind="@JobRef.Extract" JobId="j.ExtractJobId" Cron="@j.CronExpression" AfterJobs="@(j.TriggerMode == JobTriggerMode.AfterJobs)" Dependencies="deps" /></td>
                <td class="sdc-nowrap">@(j.LoadMode == LoadMode.Replace ? "latest load" : j.LoadMode == LoadMode.Merge ? "current state" : j.RetentionDays is null ? "∞" : $"{j.RetentionDays} days")</td>
                <td class="small"><span class="sdc-clip" style="--sdc-clip-w: 10rem" title="@j.ModifiedBy">@j.ModifiedBy</span><span class="sdc-sub">@Ui.Local(j.ModifiedAtUtc)</span></td>
            </tr>
        }
    </tbody>
</table></div>

@code {
    private static string ParallelLabel(ExtractJobDef j) => string.Join(" · ",
        new[] { j.UsesParallelRead() ? $"{j.ReadParallelism} readers" : null, j.UsesParallelWrite() ? $"{j.WriteParallelism} writers" : null }.Where(x => x is not null));

    private IReadOnlyList<ExtractJobDef> jobs = [];
    private IReadOnlyList<JobDependencyRow> deps = [];
    private string filter = "";
    private bool canEdit;

    private IEnumerable<ExtractJobDef> Filtered => string.IsNullOrWhiteSpace(filter) ? jobs :
        jobs.Where(j => $"{j.Name} {j.SourceServerName} {j.SourceDatabase} {j.SourceTable} {j.TargetDatabase} {j.TargetTable}"
            .Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        jobs = await Repo.GetExtractJobsAsync();
        deps = await Repo.GetJobDependenciesAsync();
        canEdit = await Access.CanEditAsync();
    }
}
