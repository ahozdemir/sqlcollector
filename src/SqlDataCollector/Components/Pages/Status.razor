@page "/"
@attribute [Authorize(Policy = AppRoles.Viewer)]
@inject MetadataRepository Repo
@inject Hangfire.JobStorage Storage
@inject CertificateManager Certificates

<PageTitle>Status – SqlHarbor</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="h4 mb-0 me-auto">Status</h1>
    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">Refresh</button>
</div>

@if (Certificates.Enabled && Certificates.Info is { DaysLeft: <= SqlDataCollector.Alerts.AlertEvents.CertWarningDays } cert)
{
    <div class="alert alert-warning py-2 small">
        The HTTPS certificate <span class="mono">@cert.Subject</span> @(cert.DaysLeft >= 0 ? $"expires in {cert.DaysLeft} days ({cert.NotAfterUtc:yyyy-MM-dd})" : $"expired on {cert.NotAfterUtc:yyyy-MM-dd}").
        An Admin can import a new one on <a href="/admin/settings">Settings</a>.
    </div>
}

<div class="sdc-kpis">
    <div class="sdc-kpi @(servers.Count == 0 ? "err" : "ok")">
        <div class="sdc-kpi-label">Workers online</div>
        <div class="sdc-kpi-value">@servers.Count</div>
        <div class="sdc-kpi-sub">@servers.Sum(s => s.WorkersCount) worker threads</div>
    </div>
    <div class="sdc-kpi">
        <div class="sdc-kpi-label">Active jobs</div>
        <div class="sdc-kpi-value">@rows.Count(r => r.IsActive)</div>
        <div class="sdc-kpi-sub">@rows.Count(r => r.IsActive && r.JobKind == "Extract") extract · @rows.Count(r => r.IsActive && r.JobKind == "Export") export</div>
    </div>
    <div class="sdc-kpi ok">
        <div class="sdc-kpi-label">Last run succeeded</div>
        <div class="sdc-kpi-value">@rows.Count(r => r.LastStatus == "Succeeded")</div>
        <div class="sdc-kpi-sub">of @rows.Count jobs</div>
    </div>
    <div class="sdc-kpi @(Problems > 0 ? "err" : "")">
        <div class="sdc-kpi-label">Last run with problems</div>
        <div class="sdc-kpi-value">@Problems</div>
        <div class="sdc-kpi-sub">failed, partial or abandoned</div>
    </div>
    <div class="sdc-kpi run">
        <div class="sdc-kpi-label">Queue</div>
        <div class="sdc-kpi-value">@processing <span class="fs-6 text-muted fw-normal">running</span></div>
        <div class="sdc-kpi-sub">@enqueued waiting · @failed failed in Hangfire (24 h)</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="section-title mb-2">Hangfire worker servers <HelpLink Topic="architecture" Title="Web and Worker roles" /></div>
        @if (servers.Count == 0)
        {
            <div class="text-danger small">No active worker! Jobs stay in the queue. Check that a Worker (<code>Collector:Roles = Worker</code>) or the shared Hangfire host is running and listens to the <code>sdc_*</code> queues.</div>
        }
        else
        {
            @foreach (var s in servers)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 small py-1">
                    <span class="sdc-status ok">online</span>
                    <span class="mono">@s.Name</span>
                    <span class="text-muted">@s.WorkersCount workers · queues @string.Join(", ", s.Queues) · heartbeat @Ui.Local(s.Heartbeat)</span>
                </div>
            }
        }
    </div>
</div>

<div class="section-title mb-2 mt-4">Jobs – last run</div>
<table class="table table-sm table-hover bg-white">
    <thead class="table-light">
        <tr><th>Type</th><th>Job</th><th>Schedule</th><th>Last status</th><th>Started</th><th>Duration</th><th class="text-end">Rows</th><th>Error</th></tr>
    </thead>
    <tbody>
        @foreach (var r in rows)
        {
            <tr class="@(r.IsActive ? "" : "text-muted")">
                <td>@r.JobKind</td>
                <td><a href="@(r.JobKind == "Extract" ? $"/extract/{r.JobId}" : $"/export/{r.JobId}")">@r.Name</a> @if (!r.IsActive) { <span class="badge bg-light text-dark border">inactive</span> }</td>
                <td><ScheduleCell Kind="@r.JobKind" JobId="r.JobId" Cron="@r.CronExpression" Dependencies="deps" /></td>
                <td><StatusBadge Status="@r.LastStatus" /></td>
                <td>@Ui.Local(r.StartedAtUtc)</td>
                <td>@(r.StartedAtUtc is null ? "" : Ui.Duration(r.StartedAtUtc.Value, r.FinishedAtUtc))</td>
                <td class="text-end">@r.Rows?.ToString("N0")</td>
                <td class="small text-danger">@Ui.ShortError(r.ErrorMessage)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<JobStatusRow> rows = [];
    private IReadOnlyList<JobDependencyRow> deps = [];
    private IList<Hangfire.Storage.Monitoring.ServerDto> servers = [];
    private long enqueued, processing, failed;
    private int Problems => rows.Count(r => r.LastStatus is "Failed" or "PartiallyFailed" or "Abandoned" or "CleanupPending");

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        rows = await Repo.GetJobStatusAsync();
        deps = await Repo.GetJobDependenciesAsync();
        var mon = Storage.GetMonitoringApi();
        // any Hangfire server (ours or a shared host) that listens to at least one SqlDataCollector queue
        servers = mon.Servers().Where(s => s.Queues.Any(q => CollectorQueues.All.Contains(q, StringComparer.OrdinalIgnoreCase))).ToList();
        var stats = mon.GetStatistics();
        enqueued = stats.Enqueued; processing = stats.Processing;
        failed = mon.FailedByDatesCount().Where(kv => kv.Key >= DateTime.UtcNow.Date.AddDays(-1)).Sum(kv => kv.Value);
    }
}
