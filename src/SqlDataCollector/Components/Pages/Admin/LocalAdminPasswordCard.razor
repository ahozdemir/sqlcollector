@inject LocalAdminStore Store
@inject MetadataRepository Repo
@inject AccessService Access

@if (Store.Enabled)
{
    <div class="card mb-4"><div class="card-body">
        <div class="section-title mb-2">Local administrator password</div>
        @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2 small">@error</div> }
        @if (!string.IsNullOrEmpty(info)) { <div class="alert alert-success py-2 small">@info</div> }
        <div class="row g-2">
            <div class="col-md-4"><input type="password" class="form-control form-control-sm" placeholder="Current password" @bind="currentPwd" autocomplete="current-password" /></div>
            <div class="col-md-3"><input type="password" class="form-control form-control-sm" placeholder="New password" @bind="newPwd" autocomplete="new-password" /></div>
            <div class="col-md-3"><input type="password" class="form-control form-control-sm" placeholder="Repeat" @bind="confirmPwd" autocomplete="new-password" /></div>
            <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" @onclick="ChangeAsync">Change</button></div>
        </div>
        <div class="form-text">For the emergency account <span class="mono">@Store.Username</span> (at least @LocalAdminStore.MinLength characters).
            Disable it entirely with <span class="mono">LocalAdmin:Enabled=false</span> once AD admins are set up.</div>
    </div></div>
}

@code {
    private string? currentPwd, newPwd, confirmPwd, error, info;

    private async Task ChangeAsync()
    {
        error = null; info = null;
        try
        {
            if (!PasswordHasher.Verify(currentPwd ?? "", await Store.GetHashAsync())) throw new InvalidOperationException("The current password is wrong.");
            if (LocalAdminStore.Validate(newPwd, confirmPwd) is { } problem) throw new InvalidOperationException(problem);
            await Store.SetPasswordAsync(newPwd!, await Access.UserNameAsync());
            info = "Password changed.";
            currentPwd = newPwd = confirmPwd = null;
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
