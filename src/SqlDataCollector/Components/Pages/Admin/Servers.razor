@page "/admin/servers"
@attribute [Authorize(Policy = AppRoles.Admin)]
@using Microsoft.Extensions.Options
@using SqlDataCollector.Options
@inject MetadataRepository Repo
@inject CatalogService Catalog
@inject AccessService Access
@inject SqlConnectionFactory Factory
@inject IOptions<CollectorOptions> Opts
@inject PermissionChecker Checker
@inject PermissionCheckRequester Requester

<PageTitle>Servers</PageTitle>

<div class="d-flex align-items-center mb-2">
    <h1 class="h4 mb-0 me-auto">Servers <HelpLink Topic="servers" Title="Servers and service accounts" /></h1>
</div>
<p class="small text-muted">All connections use the application's AD service account (Integrated Security); no passwords are stored.
    Use <b>Check permissions</b> below to verify that the service accounts have the minimum permissions – and nothing more.</p>

@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2">@error</div> }

@* ------------------------------------------------------------ system databases *@
<div class="section-title mt-3 mb-1">System databases <span class="small text-muted fw-normal">– from configuration, read-only</span> <HelpLink Topic="servers-system" Title="System databases" /></div>
<table class="table table-sm bg-white mb-1">
    <thead class="table-light"><tr><th style="width:130px">Purpose</th><th>Server</th><th>Database</th><th>Authentication</th><th>Settings</th></tr></thead>
    <tbody>
        <tr>
            <td><b>Metadata</b></td>
            <td class="mono">@meta.Server</td>
            <td class="mono">@(meta.Database ?? "(default)")</td>
            <td class="small">@meta.Authentication</td>
            <td class="small">etl schema · AutoCreateSchema=@Opts.Value.AutoCreateSchema</td>
        </tr>
        <tr>
            <td><b>Hangfire</b></td>
            <td class="mono">@hangfire.Server</td>
            <td class="mono">@(hangfire.Database ?? "(default)")</td>
            <td class="small">@hangfire.Authentication</td>
            <td class="small">
                @if (Factory.IsSharedHangfire) { <span class="badge bg-info-subtle text-info-emphasis border">Shared Hangfire database</span> }
                else { <span class="badge bg-light text-dark border">Embedded (metadata database)</span> }
                schema <span class="mono">@Opts.Value.HangfireSchema</span> · HangfirePrepareSchema=@Opts.Value.HangfirePrepareSchema
            </td>
        </tr>
    </tbody>
</table>
<p class="small text-muted mb-4">Shown as configured for this Web process (<span class="mono">ConnectionStrings:Metadata</span>, <span class="mono">ConnectionStrings:Hangfire</span>,
    <span class="mono">Collector:*</span>); Workers use their own configuration file. The application needs these connections to start,
    so they are changed in appsettings (samples in <span class="mono">deploy/</span>) followed by a service restart – not here.</p>

@* ------------------------------------------------------------ target / source servers *@
<div class="d-flex align-items-center mb-1">
    <div class="section-title me-auto">Target servers <span class="small text-muted fw-normal">– collected data is written here, exports read from here</span></div>
    <button class="btn btn-sm btn-primary" @onclick="() => New(target: true)">+ New target server</button>
</div>
@ServerTable((servers.Where(s => s.IsTarget).ToList(), true))

<div class="d-flex align-items-center mb-1 mt-4">
    <div class="section-title me-auto">Source servers <span class="small text-muted fw-normal">– read only</span></div>
    <button class="btn btn-sm btn-primary" @onclick="() => New(target: false)">+ New source server</button>
</div>
@ServerTable((servers.Where(s => s.IsSource).ToList(), false))

@if (servers.Any(s => !s.IsSource && !s.IsTarget))
{
    <div class="alert alert-warning py-2 small mt-3">
        Not assigned (neither source nor target, cannot be used by jobs):
        @foreach (var s in servers.Where(s => !s.IsSource && !s.IsTarget))
        {
            <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => Edit(s)">@s.Name</button>
        }
    </div>
}

@if (editing is not null)
{
    <div class="card mt-3"><div class="card-body">
        <div class="section-title mb-2">@(editing.SqlServerId == 0 ? "New server" : $"Edit: {editing.Name}")</div>
        <div class="row g-2">
            <div class="col-md-3"><label class="form-label small">Name (display)</label><input class="form-control form-control-sm" @bind="editing.Name" /></div>
            <div class="col-md-4"><label class="form-label small">Address (host, host\instance, host,port, AG listener)</label><input class="form-control form-control-sm mono" @bind="editing.ServerAddress" /></div>
            <div class="col-md-5"><label class="form-label small">Description</label><input class="form-control form-control-sm" @bind="editing.Description" /></div>
            <div class="col-md-2"><label class="form-label small">Encrypt</label>
                <select class="form-select form-select-sm" @bind="editing.EncryptMode"><option>Mandatory</option><option>Strict</option><option>Optional</option></select></div>
            <div class="col-md-2"><label class="form-label small">Connect timeout (s)</label><input type="number" class="form-control form-control-sm" @bind="editing.ConnectTimeoutSec" /></div>
            <div class="col-md-8 d-flex flex-wrap gap-3 align-items-end small">
                <span class="text-muted">Used as:</span>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="s1" @bind="editing.IsSource" /><label class="form-check-label" for="s1">Source</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="s2" @bind="editing.IsTarget" /><label class="form-check-label" for="s2">Target</label></div>
                <span class="text-muted ms-3">Connection:</span>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="s3" @bind="editing.TrustServerCertificate" /><label class="form-check-label" for="s3">TrustServerCertificate</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="s4" @bind="editing.ReadOnlyIntent" /><label class="form-check-label" for="s4">ApplicationIntent=ReadOnly (read from AG secondary)</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="s5" @bind="editing.MultiSubnetFailover" /><label class="form-check-label" for="s5">MultiSubnetFailover</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="s6" @bind="editing.IsActive" /><label class="form-check-label" for="s6">Active</label></div>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-sm btn-primary" @onclick="SaveAsync">Save</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => TestAsync(editing)">Test connection</button>
            <button class="btn btn-sm btn-link" @onclick="() => editing = null">Cancel</button>
            @if (editing.SqlServerId != 0) { <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="DeleteAsync">Delete</button> }
        </div>
        @if (tests.TryGetValue(editing.SqlServerId, out var et)) { <div class="small mt-2 @(et.Ok ? "text-success" : "text-danger")">@et.Message</div> }
    </div></div>
}

@* ------------------------------------------------------------ permission check *@
<div class="d-flex align-items-center mt-5 mb-1 gap-2">
    <div class="section-title me-auto">Service account permissions <HelpLink Topic="permission-check" Title="Permission check" /></div>
    <div class="form-check small mb-0"><input class="form-check-input" type="checkbox" id="onlyProblems" @bind="onlyProblems" /><label class="form-check-label" for="onlyProblems">Only problems</label></div>
    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadChecksAsync" disabled="@checking">Refresh results</button>
    <button class="btn btn-sm btn-primary" @onclick="CheckAsync" disabled="@checking">@(checking ? "Checking…" : "Check permissions")</button>
</div>
<p class="small text-muted">Checks the Web account directly and queues a check job on every queue a Hangfire server listens to, so each Worker checks its own account.
    Read-only (<span class="mono">HAS_PERMS_BY_NAME</span>): no data is read or written. Workers also check themselves on startup.</p>
@if (!string.IsNullOrEmpty(checkInfo)) { <div class="alert alert-info py-2 small">@checkInfo</div> }

@if (checks.Count == 0)
{
    <div class="text-muted small">No results yet – click <b>Check permissions</b>.</div>
}
@foreach (var g in checks.GroupBy(r => (r.ProcessRole, r.Queue, r.HostName)))
{
    var first = g.First();
    var visible = g.Where(r => !onlyProblems || r.Status != CheckStatus.Ok).ToList();
    <div class="card mb-3"><div class="card-body p-2">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <b>@first.ProcessRole@(first.Queue is null ? "" : $" · queue {first.Queue}")</b>
            <span class="small text-muted">host <span class="mono">@first.HostName</span> · account <span class="mono">@first.ProcessAccount</span> · checked @Ui.Local(g.Max(r => r.CheckedAtUtc))</span>
            <span class="ms-auto"></span>
            @foreach (var s in g.GroupBy(r => r.Status).OrderBy(s => StatusOrder(s.Key)))
            {
                <span class="badge @Ui.CheckStatusClass(s.Key)">@s.Count() @s.Key</span>
            }
        </div>
        @if (visible.Count == 0)
        {
            <div class="small text-success">All checks passed.</div>
        }
        else
        {
            <table class="table table-sm mb-0 small">
                <thead class="table-light"><tr><th>Category</th><th>Server</th><th>Database</th><th>Login</th><th>Check</th><th>Status</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var r in visible)
                    {
                        <tr>
                            <td>@r.Category</td>
                            <td class="mono">@r.ServerName</td>
                            <td class="mono">@(r.DatabaseName ?? "–")</td>
                            <td class="mono">@(r.LoginName ?? "–")</td>
                            <td>@r.Item</td>
                            <td><span class="badge @Ui.CheckStatusClass(r.Status)">@r.Status</span></td>
                            <td style="max-width:520px">@r.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div></div>
}

@code {
    private IReadOnlyList<SqlServerDef> servers = [];
    private Dictionary<int, (int AsSource, int AsTarget)> usage = new();
    private SqlServerDef? editing;
    private readonly Dictionary<int, ConnectionTestResult> tests = new();
    private string? error;

    private ConnectionDescription meta = null!;
    private ConnectionDescription hangfire = null!;

    private IReadOnlyList<PermissionCheckRow> checks = [];
    private bool checking;
    private bool onlyProblems;
    private string? checkInfo;

    protected override async Task OnInitializedAsync()
    {
        meta = SqlConnectionFactory.Describe(Factory.MetadataConnectionString);
        hangfire = SqlConnectionFactory.Describe(Factory.HangfireConnectionString);
        await LoadServersAsync();
        await LoadChecksAsync();
    }

    private RenderFragment<(List<SqlServerDef> List, bool Target)> ServerTable => args =>
        @<table class="table table-sm table-hover bg-white">
            <thead class="table-light"><tr><th>Name</th><th>Address</th><th>Used by</th><th>Connection</th><th>State</th><th>Test</th><th></th></tr></thead>
            <tbody>
                @if (args.List.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted small">@(args.Target ? "No target server defined yet." : "No source server defined yet.")</td></tr>
                }
                @foreach (var s in args.List)
                {
                    var u = usage.GetValueOrDefault(s.SqlServerId);
                    var n = args.Target ? u.AsTarget : u.AsSource;
                    <tr class="@(s.IsActive ? "" : "text-muted")">
                        <td>@s.Name @if (s.IsSource && s.IsTarget) { <span class="badge bg-light text-dark border ms-1">source + target</span> }
                            <div class="small text-muted">@s.Description</div></td>
                        <td class="mono">@s.ServerAddress</td>
                        <td class="small">@(n == 0 ? "–" : $"{n} job(s)")</td>
                        <td class="small">Encrypt=@s.EncryptMode @(s.TrustServerCertificate ? "· TrustCert" : "") @(s.ReadOnlyIntent ? "· ReadOnly" : "") @(s.MultiSubnetFailover ? "· MSF" : "")</td>
                        <td>@(s.IsActive ? "Active" : "Inactive")</td>
                        <td class="small" style="max-width:380px">
                            @if (tests.TryGetValue(s.SqlServerId, out var t)) { <span class="@(t.Ok ? "text-success" : "text-danger")">@t.Message</span> }
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => TestAsync(s)">Test</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(s)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>;

    private static int StatusOrder(string status) => status switch
    {
        CheckStatus.Missing => 0, CheckStatus.Error => 1, CheckStatus.Excess => 2, CheckStatus.Warning => 3, _ => 4
    };

    private async Task LoadServersAsync()
    {
        servers = await Repo.GetServersAsync();
        var extracts = await Repo.GetExtractJobsAsync();
        var exports = await Repo.GetExportJobsAsync();
        usage = servers.ToDictionary(s => s.SqlServerId, s => (
            extracts.Count(j => j.SourceServerId == s.SqlServerId),
            extracts.Count(j => j.TargetServerId == s.SqlServerId) + exports.Count(e => e.SourceServerId == s.SqlServerId)));
    }

    private async Task LoadChecksAsync() => checks = await Repo.GetPermissionChecksAsync();

    private async Task CheckAsync()
    {
        checking = true; checkInfo = null; error = null;
        try
        {
            await Checker.CheckAndSaveAsync(Checker.WebContext(), CancellationToken.None);
            var req = Requester.RequestWorkerChecks();
            checkInfo = "Web account checked. "
                + (req.Enqueued.Count > 0 ? $"Worker checks queued on {string.Join(", ", req.Enqueued)} – click Refresh results in a few seconds. " : "")
                + (req.NoServer.Count > 0 ? $"No live Hangfire server listens on {string.Join(", ", req.NoServer)}; that queue was not checked." : "");
            await LoadChecksAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { checking = false; }
    }

    private void New(bool target) => editing = new SqlServerDef { IsSource = !target, IsTarget = target };
    private void Edit(SqlServerDef s) => editing = new SqlServerDef
    {
        SqlServerId = s.SqlServerId, Name = s.Name, ServerAddress = s.ServerAddress, IsSource = s.IsSource, IsTarget = s.IsTarget,
        EncryptMode = s.EncryptMode, TrustServerCertificate = s.TrustServerCertificate, ReadOnlyIntent = s.ReadOnlyIntent,
        MultiSubnetFailover = s.MultiSubnetFailover, ConnectTimeoutSec = s.ConnectTimeoutSec, Description = s.Description, IsActive = s.IsActive
    };

    private async Task TestAsync(SqlServerDef s) => tests[s.SqlServerId] = await Catalog.TestAsync(s);

    private async Task SaveAsync()
    {
        error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(editing!.Name) || string.IsNullOrWhiteSpace(editing.ServerAddress)) throw new InvalidOperationException("Name and address are required.");
            if (!editing.IsSource && !editing.IsTarget) throw new InvalidOperationException("Select Source and/or Target.");
            await Repo.SaveServerAsync(editing, await Access.UserNameAsync());
            editing = null;
            await LoadServersAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeleteAsync()
    {
        error = null;
        try
        {
            await Repo.DeleteServerAsync(editing!.SqlServerId, await Access.UserNameAsync());
            editing = null;
            await LoadServersAsync();
        }
        catch (Microsoft.Data.SqlClient.SqlException ex) when (ex.Number == 547) { error = "Jobs are using this server; delete them first or make the server inactive."; }
        catch (Exception ex) { error = ex.Message; }
    }
}
