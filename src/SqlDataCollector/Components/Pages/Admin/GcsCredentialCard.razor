@using Microsoft.AspNetCore.Components.Forms
@using SqlDataCollector.Export
@inject GcsCredentialStore Store
@inject GcsUploader Uploader
@inject AccessService Access

<div class="card mb-4"><div class="card-body">
    <div class="section-title mb-2">Google Cloud Storage credential <HelpLink Topic="gcs" Title="GCS settings" /></div>
    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2 small">@error</div> }
    @if (!string.IsNullOrEmpty(info)) { <div class="alert alert-success py-2 small">@info</div> }
    <div class="small mb-2">In use: <b>@source</b> – @detail</div>
    @if (keyInfo is not null)
    {
        @if (source != GcsCredentialSource.StoredKey) { <div class="small text-muted mb-1">Uploaded credential (stored, not in use while the configuration takes precedence):</div> }
        <table class="table table-sm small mb-2">
            @if (keyInfo.IsWorkloadIdentityFederation)
            {
                <tr><td class="text-muted" style="width:160px">Method</td><td>Workload Identity Federation (keyless)</td></tr>
                <tr><td class="text-muted">Acts as</td><td class="mono">@keyInfo.ClientEmail</td></tr>
                <tr><td class="text-muted">Provider</td><td class="mono text-break">@keyInfo.Audience</td></tr>
                <tr><td class="text-muted">External token</td><td class="mono text-break">@keyInfo.TokenSource</td></tr>
            }
            else
            {
                <tr><td class="text-muted" style="width:160px">Service account</td><td class="mono">@keyInfo.ClientEmail</td></tr>
                <tr><td class="text-muted">Project</td><td class="mono">@keyInfo.ProjectId</td></tr>
                <tr><td class="text-muted">Key id</td><td class="mono">@keyInfo.PrivateKeyId</td></tr>
            }
            <tr><td class="text-muted">Uploaded</td><td>@keyInfo.UploadedBy · @Ui.Local(keyInfo.UploadedAtUtc)</td></tr>
        </table>
    }
    @if (source is GcsCredentialSource.File or GcsCredentialSource.Anonymous)
    {
        <div class="small text-muted mb-2">The configuration (<span class="mono">Gcs:CredentialsPath</span> / <span class="mono">Gcs:Anonymous</span>) takes precedence over an uploaded credential.</div>
    }
    <div class="row g-3">
        <div class="col-md-6">
            <div class="small fw-semibold mb-1">Upload a credential file (JSON)</div>
            @if (!Store.CanStoreKeys)
            {
                <div class="small text-danger">Secrets:Key is not configured in appsettings, so keys cannot be stored encrypted. The installer writes it.</div>
            }
            else
            {
                <InputFile OnChange="FileChosen" accept=".json" class="form-control form-control-sm mb-2" />
                <button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@(json is null || busy)">Save credential</button>
                @if (keyInfo is not null) { <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RemoveAsync" disabled="@busy">Remove credential</button> }
                <div class="form-text">A <b>Workload Identity Federation</b> configuration (keyless, <span class="mono">gcloud iam workload-identity-pools create-cred-config</span>)
                    or a service account key. Stored AES-256 encrypted in the metadata database (all Workers use it). The identity only needs
                    <i>Storage Object Creator</i> on the export buckets.</div>
            }
        </div>
        <div class="col-md-6">
            <div class="small fw-semibold mb-1">Test</div>
            <input class="form-control form-control-sm mono mb-2" placeholder="Bucket (optional: writes a small test object)" @bind="bucket" />
            <button class="btn btn-sm btn-outline-secondary" @onclick="TestAsync" disabled="@busy">@(busy ? "Testing…" : "Test connection")</button>
            <div class="form-text">Runs in this Web process; export Workers on other machines need the same network access (HTTPS to storage.googleapis.com).</div>
        </div>
    </div>
</div></div>

@code {
    private GcsCredentialSource source;
    private string detail = "";
    private GcsKeyInfo? keyInfo;
    private string? json;
    private string? bucket;
    private string? error, info;
    private bool busy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        (source, detail, keyInfo) = await Store.DescribeAsync();
        keyInfo ??= await Store.GetStoredInfoAsync();
    }

    private async Task FileChosen(InputFileChangeEventArgs e)
    {
        error = null;
        try
        {
            using var r = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 64 * 1024));
            json = await r.ReadToEndAsync();
            GcsCredentialStore.ParseKey(json, "check");
        }
        catch (Exception ex) { error = ex.Message; json = null; }
    }

    private async Task SaveAsync()
    {
        busy = true; error = null; info = null;
        try
        {
            var k = await Store.SaveKeyAsync(json!, await Access.UserNameAsync());
            info = (k.IsWorkloadIdentityFederation ? $"Workload Identity Federation configuration ({k.ClientEmail}) saved" : $"Key of {k.ClientEmail} saved")
                + "; uploads use it from now on. Use Test connection to check that the external token is accepted.";
            json = null;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; await RefreshAsync(); }
    }

    private async Task RemoveAsync()
    {
        busy = true; error = null; info = null;
        try { await Store.RemoveKeyAsync(await Access.UserNameAsync()); info = "Credential removed."; }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; await RefreshAsync(); }
    }

    private async Task TestAsync()
    {
        busy = true; error = null; info = null;
        try { info = await Uploader.TestAsync(bucket, CancellationToken.None); }
        catch (Exception ex) { error = $"Test failed: {ex.Message}"; }
        finally { busy = false; }
    }
}
