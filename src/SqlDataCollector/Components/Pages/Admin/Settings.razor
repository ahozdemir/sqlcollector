@page "/admin/settings"
@attribute [Authorize(Policy = AppRoles.Admin)]
@using Hangfire
@using Microsoft.Extensions.Options
@using SqlDataCollector.Options
@using SqlDataCollector.Export
@inject SystemSettingsService SettingsService
@inject CatalogService Catalog
@inject AccessService Access
@inject IRecurringJobManager Recurring
@inject IOptions<CollectorOptions> Opts

<PageTitle>Settings</PageTitle>

<h1 class="h4 mb-2">Settings <HelpLink Topic="settings" Title="Retention and cleanup settings" /></h1>
<p class="small text-muted">Organization-wide policies, stored in the metadata database and used by every process without a restart.
    Settings marked <span class="badge bg-light text-dark border">from configuration</span> have not been saved here yet and come from appsettings.
    Connections, roles/queues, folders and security settings stay in appsettings.</p>

@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2">@error</div> }
@if (!string.IsNullOrEmpty(info)) { <div class="alert alert-success py-2">@info</div> }

@if (form is not null)
{
    <div class="card mb-4"><div class="card-body">
        <div class="section-title mb-2">Retention policy for collected data</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Default retention (days)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="form.DefaultDays" placeholder="none" />
                <div class="form-text">@Origin(SystemSettingsService.DefaultDaysKey) Pre-filled in new extract jobs.</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Maximum retention (days)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="form.MaxDays" placeholder="no maximum" />
                <div class="form-text">@Origin(SystemSettingsService.MaxDaysKey) Enforced on save; longer retentions of existing jobs are capped by the retention job.</div>
            </div>
            <div class="col-md-6 d-flex flex-column gap-2 small pt-4">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="kf" @bind="form.AllowKeepForever" />
                    <label class="form-check-label" for="kf">Allow "keep forever" (empty retention) @Origin(SystemSettingsService.AllowKeepForeverKey)</label>
                    <div class="form-text">If not allowed, jobs without retention get the default (or the maximum).</div></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="ed" @bind="form.EditorsMayChange" />
                    <label class="form-check-label" for="ed">Editors may change the retention of their jobs @Origin(SystemSettingsService.EditorsMayChangeKey)</label>
                    <div class="form-text">If not, only Admins can; Editors' new jobs get the default.</div></div>
            </div>
        </div>

        <div class="section-title mt-4 mb-2">Schedule and housekeeping</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Retention schedule (cron)</label>
                <input class="form-control form-control-sm mono" @bind="form.Cron" />
                <div class="form-text">@Origin(SystemSettingsService.CronKey) @CronInfo()</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Run history (days)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="form.RunLogDays" />
                <div class="form-text">@Origin(SystemSettingsService.RunLogDaysKey) etl.LoadRun / etl.ExportRun</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Audit log (days)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="form.AuditDays" />
                <div class="form-text">@Origin(SystemSettingsService.AuditDaysKey)</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Permission check results (days)</label>
                <input type="number" min="1" class="form-control form-control-sm" @bind="form.PermissionCheckDays" />
                <div class="form-text">@Origin(SystemSettingsService.PermissionCheckDaysKey)</div>
            </div>
        </div>
        <div class="row g-3 mt-0">
            <div class="col-md-3">
                <label class="form-label small sdc-label-line">Local export archive <HelpLink Topic="export-archive" Title="Local export archive" /></label>
                <select class="form-select form-select-sm" @bind="archiveDays">
                    @for (var d = ExportArchive.MinDays; d <= ExportArchive.MaxDays; d++) { <option value="@d">@d @(d == 1 ? "day" : "days")</option> }
                </select>
                <div class="form-text">@if (!archiveStored) { <span class="badge bg-light text-dark border fw-normal">from configuration</span> }
                    Copies of the uploaded CSV/Parquet files on the export Worker; a full export run again on the same day replaces that day's copy.
                    @if (!Opts.Value.KeepLocalFiles) { <span class="text-warning">Off on this server (Collector:KeepLocalFiles = false).</span> }</div>
            </div>
        </div>
        <div class="mt-3"><button class="btn btn-sm btn-primary" @onclick="SaveAsync">Save settings</button></div>
        <p class="small text-muted mt-3 mb-0">Not managed here: files in GCS, S3 or Azure – use a lifecycle rule on the bucket (e.g. delete objects after N days);
            Hangfire's own job history.</p>
    </div></div>

    <HttpsCertificateCard />
    <GcsCredentialCard />
    <LocalAdminPasswordCard />

    <div class="card"><div class="card-body">
        <div class="d-flex align-items-center mb-2">
            <div class="section-title me-auto">Orphaned collector tables</div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="FindOrphansAsync" disabled="@searching">@(searching ? "Searching…" : "Find orphaned tables")</button>
        </div>
        <p class="small text-muted">Tables with <span class="mono">_LoadId</span>/<span class="mono">_ExtractJobId</span> in the target databases used by jobs that no extract job writes to
            (e.g. left behind by deleted jobs). Retention never touches them. Nothing is dropped here – review and drop them on the server if no longer needed.</p>
        @foreach (var e in orphanErrors) { <div class="small text-danger">@e</div> }
        @if (orphans is not null)
        {
            @if (orphans.Count == 0) { <div class="small text-success">No orphaned tables found.</div> }
            else
            {
                <table class="table table-sm small mb-0">
                    <thead class="table-light"><tr><th>Server</th><th>Database</th><th>Table</th><th class="text-end">Rows</th></tr></thead>
                    <tbody>
                        @foreach (var o in orphans)
                        {
                            <tr><td>@o.ServerName</td><td class="mono">@o.Database</td><td class="mono">@o.Schema.@o.Table</td><td class="text-end">@(o.Rows?.ToString("N0", Ui.Culture) ?? "–")</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div></div>
}

@code {
    private sealed class Form
    {
        public int? DefaultDays { get; set; }
        public int? MaxDays { get; set; }
        public bool AllowKeepForever { get; set; }
        public bool EditorsMayChange { get; set; }
        public string Cron { get; set; } = "";
        public int RunLogDays { get; set; }
        public int AuditDays { get; set; }
        public int PermissionCheckDays { get; set; }

        public RetentionPolicy ToPolicy() => new(DefaultDays, MaxDays, AllowKeepForever, EditorsMayChange, Cron ?? "", RunLogDays, AuditDays, PermissionCheckDays);
    }

    private Form? form;
    private IReadOnlySet<string> stored = new HashSet<string>();
    private int archiveDays = ExportArchive.DefaultDays;
    private bool archiveStored;
    private string? error, info;
    private IReadOnlyList<OrphanTable>? orphans;
    private IReadOnlyList<string> orphanErrors = [];
    private bool searching;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var (p, s) = await SettingsService.GetAsync();
        stored = s;
        (archiveDays, archiveStored) = await SettingsService.GetExportArchiveDaysAsync();
        form = new Form
        {
            DefaultDays = p.DefaultDays, MaxDays = p.MaxDays, AllowKeepForever = p.AllowKeepForever, EditorsMayChange = p.EditorsMayChange,
            Cron = p.Cron, RunLogDays = p.RunLogDays, AuditDays = p.AuditDays, PermissionCheckDays = p.PermissionCheckDays
        };
    }

    private RenderFragment Origin(string key) => __builder =>
    {
        if (!stored.Contains(key))
        {
            <span class="badge bg-light text-dark border fw-normal">from configuration</span>
        }
    };

    private string CronInfo()
    {
        var (ok, err, next) = JobRegistrar.Preview(form!.Cron ?? "", Opts.Value.SystemTimeZone, 2);
        return ok ? $"Next: {string.Join(", ", next.Select(n => n.ToString("yyyy-MM-dd HH:mm", Ui.Culture)))} ({Opts.Value.SystemTimeZone})" : $"Invalid: {err}";
    }

    private async Task SaveAsync()
    {
        error = null; info = null;
        try
        {
            var user = await Access.UserNameAsync();
            await SettingsService.SaveRetentionPolicyAsync(form!.ToPolicy(), user, Recurring);
            await SettingsService.SaveExportArchiveDaysAsync(archiveDays, user);
            info = "Settings saved. The retention schedule was updated in Hangfire; new values apply to the next retention run and to job saves.";
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task FindOrphansAsync()
    {
        searching = true; error = null;
        try { (orphans, orphanErrors) = await Catalog.OrphanTablesAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { searching = false; }
    }
}
