@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject LocalAdminStore LocalAdmin

<PageTitle>Sign in – SqlDataCollector</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <h1 class="h3 mb-4 text-center">SqlDataCollector</h1>

        @if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger">@ErrorText</div> }
        @if (LoggedOut is not null) { <div class="alert alert-info">You have been signed out.</div> }

        <div class="card mb-3">
            <div class="card-body text-center">
                <p class="text-muted small mb-3">Sign in with your corporate (Active Directory) account.</p>
                <a class="btn btn-primary w-100" href="/auth/windows?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "/")">Sign in with Windows (AD)</a>
            </div>
        </div>

        @if (LocalAdmin.Enabled && needsPassword)
        {
            <details class="card" open="@(isLocal || SetupError is not null)">
                <summary class="card-header small">Local administrator – first sign-in</summary>
                <div class="card-body">
                    @if (!isLocal)
                    {
                        <div class="small text-muted">The local administrator password has not been set yet. For security it can only be set
                            on the server itself: open <span class="mono">https://localhost/login</span> there.</div>
                    }
                    else
                    {
                        <p class="small text-muted">Choose the password of the local administrator <b>@LocalAdmin.Username</b>
                            (at least @LocalAdminStore.MinLength characters). You will be signed in afterwards; then grant roles to AD users or groups on <i>Permissions</i>.</p>
                        @if (SetupError is not null) { <div class="alert alert-danger py-2 small">@SetupError</div> }
                        <form method="post" action="/auth/local-setup">
                            <AntiforgeryToken />
                            <div class="mb-2"><input class="form-control" name="password" type="password" placeholder="New password" autocomplete="new-password" required minlength="@LocalAdminStore.MinLength" /></div>
                            <div class="mb-3"><input class="form-control" name="confirm" type="password" placeholder="Repeat the password" autocomplete="new-password" required /></div>
                            <button class="btn btn-primary w-100" type="submit">Set password and sign in</button>
                        </form>
                    }
                </div>
            </details>
        }
        else if (LocalAdmin.Enabled)
        {
            <details class="card">
                <summary class="card-header small">Local administrator</summary>
                <div class="card-body">
                    <form method="post" action="/auth/local">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        <div class="mb-2"><input class="form-control" name="username" placeholder="User name" autocomplete="username" required /></div>
                        <div class="mb-3"><input class="form-control" name="password" type="password" placeholder="Password" autocomplete="current-password" required /></div>
                        <button class="btn btn-outline-secondary w-100" type="submit">Sign in</button>
                    </form>
                </div>
            </details>
        }
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? LoggedOut { get; set; }
    [SupplyParameterFromQuery] public string? SetupError { get; set; }

    private bool needsPassword;
    private bool isLocal;

    protected override async Task OnInitializedAsync()
    {
        needsPassword = await LocalAdmin.NeedsInitialPasswordAsync();
        isLocal = LocalAdminStore.IsLocalRequest(HttpContext?.Connection.RemoteIpAddress);
    }

    private string ErrorText => Error switch
    {
        "invalid" => "Invalid user name or password.",
        "locked" => "Too many failed attempts. Try again in 15 minutes.",
        "disabled" => "Local administrator sign-in is disabled.",
        "expired" => "The form expired, please try again.",
        "notlocal" => "The initial local administrator password can only be set on the server itself.",
        "alreadyset" => "The local administrator password has already been set; sign in with it.",
        _ => "Sign-in failed."
    };
}
