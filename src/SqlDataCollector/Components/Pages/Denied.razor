@page "/denied"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<div>
    <div class="card"><div class="card-body">
        <div class="alert alert-warning">
            <h1 class="h5">Access denied</h1>
            <p class="mb-1">No role is assigned to <b>@User</b> in this application.</p>
            <p class="mb-0 small">Ask an administrator to grant the Viewer, Editor or Admin role to your account or to an AD group you belong to.</p>
        </div>
        <a href="/login">Back to sign-in</a>
    </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? User { get; set; }
}
