@* Small line icons for the side navigation (inline SVG, inherits the text color). *@
<svg class="sdc-icon" viewBox="0 0 24 24" aria-hidden="true">
    @switch (Name)
    {
        case "status":
            <path d="M3 12h4l2.5-6 4 12 2.5-6H21" />
            break;
        case "history":
            <circle cx="12" cy="12" r="8" /><path d="M12 8v4l3 2" />
            break;
        case "extract":
            <ellipse cx="7" cy="6.5" rx="4" ry="1.8" /><path d="M3 6.5v8c0 1 1.8 1.8 4 1.8s4-.8 4-1.8v-8" /><path d="M13 12h8M18 9l3 3-3 3" />
            break;
        case "export":
            <path d="M7 18h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7 9a4.5 4.5 0 0 0 0 9z" /><path d="M12 15V10M9.5 12.5 12 10l2.5 2.5" />
            break;
        case "servers":
            <rect x="4" y="4" width="16" height="6" rx="1.5" /><rect x="4" y="14" width="16" height="6" rx="1.5" /><path d="M8 7h.01M8 17h.01" />
            break;
        case "permissions":
            <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /><path d="M9 12l2 2 4-4" />
            break;
        case "alerts":
            <path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z" /><path d="M10 20a2 2 0 0 0 4 0" />
            break;
        case "privacy":
            <rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /><circle cx="12" cy="15" r="1.5" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" />
            break;
        case "audit":
            <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" />
            break;
        case "hangfire":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M8 14h3M8 17h6" />
            break;
        case "help":
            <circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5V14M12 17h.01" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
