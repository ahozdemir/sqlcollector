<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Host: Blazor UI (Roles=Web) and/or Hangfire Server (Roles=Worker). Job code lives in SqlDataCollector.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>sql-data-collector</UserSecretsId>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>SqlHarbor</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlDataCollector.Core\SqlDataCollector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

</Project>
